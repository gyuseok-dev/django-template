packages:
  yum:
    amazon-efs-utils: []

commands:
  01_create_mount_dir:
    command: "mkdir -p /efs"
  02_mount_efs:
    command: |
      EFS_ID=$(/opt/elasticbeanstalk/bin/get-config environment -k EFS_ID)
      mount -t efs -o tls $EFS_ID:/ /efs || echo "Already mounted"
  03_create_db_dir:
    command: "mkdir -p /efs/db && chown webapp:webapp /efs/db && chmod 777 /efs/db"
  04_add_fstab:
    command: |
      EFS_ID=$(/opt/elasticbeanstalk/bin/get-config environment -k EFS_ID)
      grep -q "$EFS_ID" /etc/fstab || echo "$EFS_ID:/ /efs efs _netdev,tls 0 0" >> /etc/fstab
