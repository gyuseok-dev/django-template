{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Docker Remote Attach",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/code"
                }
            ],
            "django": true,
            "preLaunchTask": "Start Docker Debug Mode"
        }
    ]
}
